        # A tensorflow.pc generated by setup_tensorflow.py carries its own -Wl,-rpath to
        # the pip package, which check_cfg stores as RPATH_TENSORFLOW. With the pip-rpath
        # switch on, that same path is already in the global LINKFLAGS and ld warns about
        # the duplicate on every link; keep the global entry, which also reaches targets
        # that do not use the TENSORFLOW uselib.
        ctx.env['RPATH_TENSORFLOW'] = [
            path for path in ctx.env['RPATH_TENSORFLOW']
            if ('-Wl,-rpath,%s' % path) not in ctx.env.LINKFLAGS]

    # needed by ffmpeg for the INT64_C macros
    ctx.env.DEFINES += ['__STDC_CONSTANT_MACROS']

    if ctx.env.WITH_EXAMPLES or ctx.env.EXAMPLES or ctx.env.WITH_VAMP:
        ctx.recurse('examples')

    if ctx.env.WITH_PYTHON:
