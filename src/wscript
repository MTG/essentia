    algos = [ 'TensorflowPredict', 'TensorflowPredictMusiCNN', 'TensorflowPredictVGGish',
              'TensorflowPredictTempoCNN', 'TensorflowPredictCREPE', 'PitchCREPE',
              'TempoCNN', 'TensorflowPredictEffnetDiscogs', 'TensorflowPredict2D',
