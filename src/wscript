        print('  The following algorithms will be ignored: %s' % algos)
        print('  Examples requiring Gaia2 will be ignored\n')
        ctx.env.ALGOIGNORE += algos

    algos = [ 'Chromaprinter' ]
    if has('libchromaprint'):
        print('- Chromaprint detected!')
