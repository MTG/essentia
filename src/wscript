    if ctx.env.WITH_PYTHON:
        for a in ['FileOutputProxy', 'FrameCutter']:
            if a not in algos:
                raise ctx.errors.ConfigurationError(
                    "%s algorithm is necessary for python bindings, however it was excluded. "
